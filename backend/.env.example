# FitMind AI backend environment template.
# Copy to .env.local and fill in real values. Do not commit .env.local.

# MongoDB connection string
MONGODB_URL=mongodb://localhost:27017

# Supabase authentication
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# AI provider API keys
GROQ_API_KEY=
GEMINI_API_KEY=

# AI limits (optional). Calls per user per local day, and provider timeout.
# AI_DAILY_QUOTA=150
# AI_TIMEOUT_SECONDS=30

# JWT signing secret. Staging/production refuse to start with this default;
# generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-secret-key-change-in-production

# Encrypts health profiles and lab values at rest. Optional locally (data is
# stored unencrypted with a warning). In staging/production the app still starts
# without it, but health features stay off (503) so nothing is stored unencrypted.
# Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: losing it makes stored health data unreadable.
HEALTH_DATA_KEY=

# Deployment environment: local | test | staging | production
# local/test fall back to an in-memory store when MongoDB is unreachable;
# staging/production fail to start instead.
DATABASE_ENV=local

# Product analytics (optional). Events are always stored in MongoDB; with a
# PostHog project API key they are also sent to PostHog (free tier).
POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Web Push reminders (optional; reminders stay off until all three are set).
# Generate a key pair with: python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services: mailto:you@example.com or your site's https URL.
VAPID_SUBJECT=

# Secret for the external cron that calls POST /api/v1/reminders/run every
# 15 minutes (header X-Cron-Secret). The endpoint is off while this is empty.
CRON_SECRET=
