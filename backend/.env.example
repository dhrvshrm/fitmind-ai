# FitMind AI backend environment template.
# Copy to .env.local and fill in real values. Do not commit .env.local.

# MongoDB connection string
MONGODB_URL=mongodb://localhost:27017

# Supabase authentication
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# AI provider API keys
GROQ_API_KEY=
GEMINI_API_KEY=

# AI limits (optional). Calls per user per local day, and provider timeout.
# AI_DAILY_QUOTA=150
# AI_TIMEOUT_SECONDS=30

# JWT signing secret. Staging/production refuse to start with this default;
# generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-secret-key-change-in-production

# Deployment environment: local | test | staging | production
# local/test fall back to an in-memory store when MongoDB is unreachable;
# staging/production fail to start instead.
DATABASE_ENV=local
